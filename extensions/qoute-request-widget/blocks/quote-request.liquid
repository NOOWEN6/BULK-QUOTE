{% comment %}
  Request a Quote widget — appears on product pages
{% endcomment %}

<div class="quote-request-widget">
  <button id="quote-request-btn" type="button">
    Request a Quote
  </button>
</div>

<div id="quote-request-modal" class="quote-request-modal" style="display:none;">
  <div class="quote-request-modal-content">
    <span id="quote-request-close">&times;</span>
    <h3>Request a Quote</h3>
    <form id="quote-request-form">
      <label>
        Quantity
        <input type="number" name="quantity" min="1" required>
      </label>
      <label>
        Company Name
        <input type="text" name="company" required>
      </label>
      <label>
        Notes (optional)
        <textarea name="notes"></textarea>
      </label>
      <button type="submit">Submit Request</button>
    </form>
  </div>
</div>

<style>
  .quote-request-widget { margin: 16px 0; }
  #quote-request-btn {
    background: #000; color: #fff; padding: 12px 24px;
    border: none; cursor: pointer; font-size: 16px;
  }
  .quote-request-modal {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); z-index: 1000;
    display: flex; align-items: center; justify-content: center;
  }
  .quote-request-modal-content {
    background: #fff; padding: 24px; border-radius: 8px;
    max-width: 400px; width: 90%; position: relative;
  }
  #quote-request-close {
    position: absolute; top: 12px; right: 16px; cursor: pointer; font-size: 20px;
  }
  #quote-request-form label { display: block; margin-bottom: 12px; }
  #quote-request-form input, #quote-request-form textarea {
    width: 100%; padding: 8px; margin-top: 4px;
  }
</style>

<script>
  document.getElementById('quote-request-btn').addEventListener('click', function() {
    document.getElementById('quote-request-modal').style.display = 'flex';
  });
  document.getElementById('quote-request-close').addEventListener('click', function() {
    document.getElementById('quote-request-modal').style.display = 'none';
  });
 
 document.getElementById('quote-request-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const form = e.target;
  const submitBtn = form.querySelector('button[type="submit"]');
  submitBtn.disabled = true;
  submitBtn.textContent = 'Submitting...';

  const formData = new FormData();
  formData.append('productId', {{ product.id | json }});
  formData.append('variantId', {{ product.selected_or_first_available_variant.id | json }});
  formData.append('quantity', form.quantity.value);
  formData.append('companyName', form.company.value);
  formData.append('notes', form.notes.value);

  try {
    const response = await fetch('/apps/apps', {
      method: 'POST',
      body: formData,
    });
    const result = await response.json();

    if (result.success) {
      let message = 'Quote request submitted successfully!';
      if (result.matchedDiscount) {
        message += ` You qualify for a ${result.matchedDiscount.discountPct}% discount.`;
      }
      alert(message);
      form.reset();
      document.getElementById('quote-request-modal').style.display = 'none';
    } else {
      alert('Something went wrong: ' + (result.error || 'Please try again.'));
    }
  } catch (err) {
    alert('Network error — please try again.');
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit Request';
  }
});
</script>

{% schema %}
{
  "name": "Quote Request Widget",
  "target": "section",
  "settings": []
}
{% endschema %}